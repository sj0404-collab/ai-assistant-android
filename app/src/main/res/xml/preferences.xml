<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="API Keys">

        <EditTextPreference
            app:key="openrouter_key"
            app:title="OpenRouter API Key"
            app:summary="Enter your OpenRouter API key"
            app:dialogTitle="OpenRouter API Key" />

        <EditTextPreference
            app:key="openai_key"
            app:title="OpenAI API Key"
            app:summary="Enter your OpenAI API key"
            app:dialogTitle="OpenAI API Key" />

        <EditTextPreference
            app:key="anthropic_key"
            app:title="Anthropic API Key"
            app:summary="Enter your Anthropic API key"
            app:dialogTitle="Anthropic API Key" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Default Provider">

        <ListPreference
            app:key="default_provider"
            app:title="Default AI Provider"
            app:summary="Select default provider"
            app:entries="@array/providers"
            app:entryValues="@array/provider_values"
            app:defaultValue="openrouter" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Terminal">

        <EditTextPreference
            app:key="opencode_path"
            app:title="OpenCode Path"
            app:summary="Path to opencode binary"
            app:defaultValue="/usr/local/bin/opencode"
            app:dialogTitle="OpenCode Path" />

        <EditTextPreference
            app:key="shell_path"
            app:title="Shell Path"
            app:summary="Path to shell"
            app:defaultValue="/bin/bash"
            app:dialogTitle="Shell Path" />

    </PreferenceCategory>

</PreferenceScreen>
